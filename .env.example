# ─────────────────────────────────────────────────────────────────────────────
#  AI DSA Mentor — environment template
#  Copy to .env and fill. Both the API (Zod) and the AI service (Pydantic)
#  validate these at boot and refuse to start on a missing/malformed value.
# ─────────────────────────────────────────────────────────────────────────────

# ── Shared ───────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Database (Neon) ──────────────────────────────────────────────────────────
# Pooled connection for the app, direct connection for migrations.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aidsamentor
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aidsamentor

# ── Redis (Upstash) ──────────────────────────────────────────────────────────
# Durability only — refresh-token denylist, job locks, expensive-endpoint
# counters. NOT a cache (10k commands/day). Leave blank to run in-memory only.
REDIS_URL=redis://localhost:6379

# ── API ──────────────────────────────────────────────────────────────────────
PORT=4000
API_URL=http://localhost:4000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug

# Generate with: openssl rand -base64 48   (must be >= 32 chars, must differ)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ── OAuth (optional — email auth works without these) ────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Code execution ───────────────────────────────────────────────────────────
# judge0 | piston | mock     ("mock" runs a deterministic local stub — no
# network, no quota. Use it for development so you never burn Judge0 credits.)
EXECUTION_PROVIDER=mock
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_HOST=judge0-ce.p.rapidapi.com
PISTON_URL=https://emkc.org/api/v2/piston
EXECUTION_DAILY_QUOTA=200

# ── AI service link ──────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
# Shared HMAC secret — must be identical in the API and the AI service.
AI_SERVICE_HMAC_SECRET=change-me-shared-hmac-secret-32-chars-min

# ── AI service (apps/ai) ─────────────────────────────────────────────────────
# Providers are tried in the order listed in the routing table. Every chain
# terminates in a non-LLM fallback, so the app works with NO keys at all —
# you get Stage-1 mentoring (complexity, warnings, authored hints) for free.
OPENROUTER_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
OLLAMA_URL=http://localhost:11434
# Ollama needs no API key, so it must be opted into explicitly — otherwise every
# turn spends seconds failing to reach a local server that isn't running.
ENABLE_OLLAMA=false

# Model ids are configuration, not code — swap providers without a deploy.
MODEL_TIER_REASON=deepseek/deepseek-r1-distill-llama-70b:free
MODEL_TIER_FAST=qwen/qwen-2.5-coder-32b-instruct:free
MODEL_TIER_TINY=meta-llama/llama-3.1-8b-instruct:free

DAILY_TOKEN_BUDGET=2000000
PER_USER_DAILY_TOKENS=60000
ENABLE_GHOST_TEXT=true
SEMANTIC_CACHE_TTL=1800
AI_LOG_LEVEL=INFO

# ── Web (apps/web) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# ── Observability (optional) ─────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Media (optional) ─────────────────────────────────────────────────────────
CLOUDINARY_URL=
